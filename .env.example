# Copy to .env (and never commit .env) to point LabDb/RunStore at Supabase Postgres.
# With these unset the project uses local SQLite (agent.db / lab.db), so demos and
# tests need no API key and no network.
#
# Get the connection string from Supabase: Project Settings -> Database ->
# "Connection string" (for a non-interactive use: postgres, direct or pooler).
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Alternative to the full URL (optional; only used when SUPABASE_DB_URL is empty).
SUPABASE_HOST=db.xxxxxxxx.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=YOUR-PASSWORD

# Local SQLite paths (used when no Supabase variables are set).
AGENT_DB=agent.db
LAB_DB=lab.db